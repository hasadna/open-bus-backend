{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc"],
  "env": {
    "node": true
  },
  "ignorePatterns": ["dist/**", "coverage/**"],
  "overrides": [
    {
      "files": ["tests/**/*.js"],
      "env": {
        "mocha": true
      },
      "rules": {
        "no-unused-expressions": "off"
      }
    }
  ]
}
