# Complaints submit
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
SES_COMPLAINTS_EMAIL=complaints@recipient-domain.example
SES_EMAIL=complaints@your-verified-domain.example
# Optional: use an existing SES configuration set in the configured AWS account and region.
# Leave unset if you do not use a configuration set.
# SES_CONFIGURATION_SET=your-existing-configuration-set

# Issuse Submit
GITHUB_TOKEN=your_github_token
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_repository_name
