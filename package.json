    "@fastify/type-provider-typebox": "^6.3.0",
    "fastify": "^5.12.8",
    "ky": "^2.2.0",
    "lru-cache": "^11.5.3",
    "pino-pretty": "^13.2.0",
    "resend": "^6.38.0",
    "typebox": "^1.4.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "sinon": "^22.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
